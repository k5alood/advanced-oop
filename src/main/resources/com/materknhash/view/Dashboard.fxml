<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.shape.Circle?>

<BorderPane fx:id="mainBorderPane" xmlns:fx="http://javafx.com/fxml" 
            fx:controller="com.materknhash.controller.DashboardController"
            stylesheets="@../css/dashboard.css">
    
    <!-- SIDEBAR -->
    <left>
        <VBox prefWidth="250" spacing="5" styleClass="sidebar">
            <VBox styleClass="logo-container">
                <Circle radius="30" styleClass="avatar"/>
                <Label text="Metrkansh" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
                <Label text="Auto Parts ERP" style="-fx-text-fill: rgb(148, 163, 184); -fx-font-size: 10px;"/>
            </VBox>
            
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent;">
                <VBox spacing="2">
                    <padding><Insets left="10" right="10"/></padding>
                    <Button text="🏠 Dashboard" maxWidth="Infinity" styleClass="nav-btn-active" onAction="#showDashboard"/>
                    <Button text="⚙️ Spare Parts" maxWidth="Infinity" styleClass="nav-btn" onAction="#showInventory"/>
                    <Button text="📑 Sales" maxWidth="Infinity" styleClass="nav-btn" onAction="#showSales"/>
                    <Button text="🛒 Purchases" maxWidth="Infinity" styleClass="nav-btn" onAction="#showPurchases"/>
                    <Button text="🤝 Suppliers" maxWidth="Infinity" styleClass="nav-btn" onAction="#showSuppliers"/>
                    <Button fx:id="reportsBtn" text="📊 Reports" maxWidth="Infinity" styleClass="nav-btn" onAction="#showReports"/>
                    <Button fx:id="usersBtn" text="👥 Users" maxWidth="Infinity" styleClass="nav-btn" onAction="#showUsers"/>
                    <Button text="🛠️ Settings" maxWidth="Infinity" styleClass="nav-btn" onAction="#showSettings"/>
                </VBox>
            </ScrollPane>
            
            <Region VBox.vgrow="ALWAYS"/>
            <Button text="🚪 Logout" onAction="#handleLogout" maxWidth="Infinity" styleClass="nav-btn" style="-fx-padding: 20;"/>
        </VBox>
    </left>

    <!-- MAIN CONTENT AREA -->
    <center>
        <StackPane fx:id="contentArea">
            <!-- Initial content is Dashboard (we'll move it to a separate FXML or handle it in controller) -->
            <VBox spacing="0">
                <!-- HEADER -->
                <HBox styleClass="header" alignment="CENTER_LEFT">
                    <Label text="Dashboard" styleClass="page-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <HBox styleClass="user-profile" alignment="CENTER">
                        <Button text="🔔" style="-fx-background-color: transparent; -fx-font-size: 18px;"/>
                        <VBox alignment="CENTER_RIGHT">
                            <Label fx:id="userNameLabel" text="Admin" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                            <Label text="Administrator" style="-fx-text-fill: rgb(100, 116, 139); -fx-font-size: 11px;"/>
                        </VBox>
                        <Circle radius="20" styleClass="avatar"/>
                    </HBox>
                </HBox>

                <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
                    <VBox spacing="25">
                        <padding><Insets top="0" right="40" bottom="40" left="40"/></padding>
                        
                        <HBox spacing="20">
                            <VBox HBox.hgrow="ALWAYS" styleClass="stat-card-blue">
                                <Label text="Total Sales" style="-fx-text-fill: rgb(30, 58, 138);"/>
                                <Label fx:id="totalSalesLabel" text="0.00 EGP" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                                <Label text="+12% from last month ↗" style="-fx-text-fill: rgb(30, 58, 138); -fx-font-size: 11px;"/>
                            </VBox>
                            <VBox HBox.hgrow="ALWAYS" styleClass="stat-card-green">
                                <Label text="Total Profit" style="-fx-text-fill: rgb(21, 128, 61);"/>
                                <Label fx:id="totalProfitLabel" text="0.00 EGP" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                                <Label text="+8% from last month ↗" style="-fx-text-fill: rgb(21, 128, 61); -fx-font-size: 11px;"/>
                            </VBox>
                            <VBox HBox.hgrow="ALWAYS" styleClass="stat-card-yellow">
                                <Label text="Total Parts" style="-fx-text-fill: rgb(180, 83, 9);"/>
                                <Label fx:id="totalPartsLabel" text="0" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                                <Label text="All spare parts" style="-fx-text-fill: rgb(180, 83, 9); -fx-font-size: 11px;"/>
                            </VBox>
                            <VBox HBox.hgrow="ALWAYS" styleClass="stat-card-red">
                                <Label text="Low Stock Alerts" style="-fx-text-fill: rgb(153, 27, 27);"/>
                                <Label fx:id="lowStockLabel" text="0" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: rgb(220, 38, 38);"/>
                                <Label text="Items low in stock" style="-fx-text-fill: rgb(153, 27, 27); -fx-font-size: 11px;"/>
                            </VBox>
                        </HBox>
                        
                        <HBox spacing="25">
                            <VBox HBox.hgrow="ALWAYS" prefHeight="450" styleClass="activity-card">
                                <Label text="Sales Overview (Last 6 Months)" style="-fx-font-weight: bold; -fx-font-size: 16px;"/>
                                <LineChart fx:id="salesChart" legendSide="TOP" animated="false" style="-fx-padding: 20 0 0 0;">
                                    <xAxis><CategoryAxis side="BOTTOM" label="Month" /></xAxis>
                                    <yAxis><NumberAxis side="LEFT" label="Revenue" /></yAxis>
                                </LineChart>
                            </VBox>
                            
                            <VBox prefWidth="350" styleClass="activity-card">
                                <Label text="Recent Activities" style="-fx-font-weight: bold; -fx-font-size: 16px;"/>
                                <VBox fx:id="recentActivitiesList" spacing="10" VBox.vgrow="ALWAYS">
                                    <padding><Insets top="15"/></padding>
                                </VBox>
                            </VBox>
                        </HBox>
                    </VBox>
                </ScrollPane>
            </VBox>
        </StackPane>
    </center>
</BorderPane>
