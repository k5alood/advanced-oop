<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.Line?>

<HBox xmlns:fx="http://javafx.com/fxml" 
      fx:controller="com.materknhash.controller.SalesController"
      spacing="30" style="-fx-background-color: transparent;"
      stylesheets="@../css/dashboard.css">
    
    <padding>
        <Insets top="30" right="40" bottom="30" left="40"/>
    </padding>

    <!-- LEFT SIDE: Product Selection & Customer Info -->
    <VBox prefWidth="420" spacing="20">
        <!-- Customer Info Card -->
        <VBox spacing="15" styleClass="activity-card">
            <Label text="Customer Information" style="-fx-font-weight: bold; -fx-font-size: 16px;"/>
            <TextField fx:id="customerNameField" promptText="Customer Name" 
                       style="-fx-background-radius: 10; -fx-padding: 10;"/>
            <TextField fx:id="customerPhoneField" promptText="Phone Number" 
                       style="-fx-background-radius: 10; -fx-padding: 10;"/>
        </VBox>

        <!-- Product Selection Card -->
        <VBox VBox.vgrow="ALWAYS" spacing="15" styleClass="activity-card">
            <Label text="Add Products to Invoice" style="-fx-font-weight: bold; -fx-font-size: 16px;"/>
            <TextField fx:id="productSearchField" promptText="🔍 Search part by name or code..." 
                       style="-fx-background-radius: 10; -fx-padding: 10;"/>
            <ListView fx:id="productListView" VBox.vgrow="ALWAYS" 
                      style="-fx-background-radius: 10; -fx-background-color: rgb(248, 250, 252);"/>
            <HBox spacing="10" alignment="CENTER">
                <Spinner fx:id="quantitySpinner" prefWidth="100" style="-fx-background-radius: 10;"/>
                <Button text="Add to Invoice" maxWidth="Infinity" HBox.hgrow="ALWAYS" onAction="#addToInvoice"
                        style="-fx-background-color: rgb(30, 58, 138); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 10;"/>
            </HBox>
        </VBox>
    </VBox>

    <!-- RIGHT SIDE: Invoice Preview & Summary -->
    <VBox HBox.hgrow="ALWAYS" spacing="20">
        <VBox VBox.vgrow="ALWAYS" styleClass="activity-card">
            <HBox alignment="CENTER_LEFT">
                <VBox spacing="2">
                    <Label text="NEW SALE INVOICE" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: rgb(15, 23, 42);"/>
                    <Label fx:id="invoiceDateLabel" text="Date: 2026-05-13" style="-fx-text-fill: rgb(100, 116, 139);"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Label text="INV-1024" style="-fx-font-weight: bold; -fx-text-fill: rgb(30, 58, 138);"/>
            </HBox>
            
            <Separator prefWidth="200" style="-fx-padding: 20 0;"/>
            
            <TableView fx:id="invoiceTable" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
                <columns>
                    <TableColumn fx:id="colItem" text="Spare Part" prefWidth="250" />
                    <TableColumn fx:id="colPrice" text="Unit Price" prefWidth="100" />
                    <TableColumn fx:id="colQty" text="Qty" prefWidth="80" />
                    <TableColumn fx:id="colTotal" text="Total" prefWidth="120" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>

            <!-- Summary Section -->
            <VBox spacing="12" alignment="BOTTOM_RIGHT" style="-fx-padding: 20 0 0 0;">
                <HBox alignment="CENTER_RIGHT" spacing="40">
                    <Label text="Subtotal:" style="-fx-text-fill: rgb(100, 116, 139);"/>
                    <Label fx:id="subtotalLabel" text="0.00 EGP" style="-fx-font-weight: bold;"/>
                </HBox>
                <HBox alignment="CENTER_RIGHT" spacing="40">
                    <Label text="Tax (14%):" style="-fx-text-fill: rgb(100, 116, 139);"/>
                    <Label fx:id="taxLabel" text="0.00 EGP" style="-fx-font-weight: bold;"/>
                </HBox>
                <Line startX="0" endX="250" stroke="rgb(226, 232, 240)"/>
                <HBox alignment="CENTER_RIGHT" spacing="40">
                    <Label text="GRAND TOTAL:" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
                    <Label fx:id="grandTotalLabel" text="0.00 EGP" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: rgb(30, 58, 138);"/>
                </HBox>
            </VBox>
        </VBox>
        
        <HBox spacing="15" alignment="CENTER_RIGHT">
            <Button text="Cancel Transaction" onAction="#clearInvoice"
                    style="-fx-background-color: transparent; -fx-text-fill: rgb(153, 27, 27); -fx-font-weight: bold; -fx-padding: 15 30;"/>
            <Button text="COMPLETE SALE &amp; PRINT" onAction="#handleCompleteSale"
                    style="-fx-background-color: rgb(22, 163, 74); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 15 50;"/>
        </HBox>
    </VBox>
    
</HBox>
