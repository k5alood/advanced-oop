<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.*?>

<VBox spacing="0" xmlns:fx="http://javafx.com/fxml" 
      fx:controller="com.materknhash.controller.ReportController"
      stylesheets="@../css/dashboard.css">
    
    <HBox styleClass="header" alignment="CENTER_LEFT">
        <Label text="Financial Reports" styleClass="page-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="📥 Export PDF" styleClass="action-btn-primary"/>
    </HBox>

    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
        <VBox spacing="25">
            <padding><Insets top="20" right="40" bottom="40" left="40"/></padding>
            
            <HBox spacing="20">
                <VBox HBox.hgrow="ALWAYS" styleClass="activity-card">
                    <Label text="Revenue Breakdown" style="-fx-font-weight: bold;"/>
                    <PieChart fx:id="revenuePieChart" prefHeight="350"/>
                </VBox>
                <VBox HBox.hgrow="ALWAYS" styleClass="activity-card">
                    <Label text="Monthly Growth" style="-fx-font-weight: bold;"/>
                    <BarChart fx:id="growthBarChart">
                        <xAxis><CategoryAxis fx:id="reportXAxis" side="BOTTOM" label="Month" /></xAxis>
                        <yAxis><NumberAxis fx:id="reportYAxis" side="LEFT" label="Revenue (EGP)" /></yAxis>
                    </BarChart>
                </VBox>
            </HBox>

            <VBox styleClass="activity-card">
                <Label text="Top Selling Spare Parts" style="-fx-font-weight: bold; -fx-padding: 0 0 10 0;"/>
                <TableView fx:id="topProductsTable" prefHeight="250" styleClass="modern-table">
                    <columns>
                        <TableColumn text="Part Name" prefWidth="250"/>
                        <TableColumn text="Category" prefWidth="150"/>
                        <TableColumn text="Units Sold" prefWidth="100"/>
                        <TableColumn text="Total Revenue" prefWidth="150"/>
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </ScrollPane>
</VBox>
