<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.Circle?>

<BorderPane fx:id="mainBorderPane" xmlns:fx="http://javafx.com/fxml" 
            fx:controller="com.materknhash.controller.DashboardController"
            stylesheets="@../css/dashboard.css">
    
    <!-- SIDEBAR -->
    <left>
        <VBox prefWidth="250" spacing="5" styleClass="sidebar">
            <VBox styleClass="logo-container">
                <Circle radius="30" styleClass="avatar"/>
                <Label text="Metrkansh" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
                <Label text="Auto Parts ERP" style="-fx-text-fill: rgb(148, 163, 184); -fx-font-size: 10px;"/>
            </VBox>
            
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent;">
                <VBox spacing="2">
                    <padding><Insets left="10" right="10"/></padding>
                    <Button text="🏠 Dashboard" maxWidth="Infinity" styleClass="nav-btn-active" onAction="#showDashboard"/>
                    <Button text="⚙️ Spare Parts" maxWidth="Infinity" styleClass="nav-btn" onAction="#showInventory"/>
                    <Button text="📑 Sales" maxWidth="Infinity" styleClass="nav-btn" onAction="#showSales"/>
                    <Button text="🛒 Purchases" maxWidth="Infinity" styleClass="nav-btn" onAction="#showPurchases"/>
                    <Button text="🤝 Suppliers" maxWidth="Infinity" styleClass="nav-btn" onAction="#showSuppliers"/>
                    <Button fx:id="reportsBtn" text="📊 Reports" maxWidth="Infinity" styleClass="nav-btn" onAction="#showReports"/>
                    <Button fx:id="usersBtn" text="👥 Users" maxWidth="Infinity" styleClass="nav-btn" onAction="#showUsers"/>
                    <Button text="🛠️ Settings" maxWidth="Infinity" styleClass="nav-btn" onAction="#showSettings"/>
                </VBox>
            </ScrollPane>
            
            <Region VBox.vgrow="ALWAYS"/>
            <Button text="🚪 Logout" onAction="#handleLogout" maxWidth="Infinity" styleClass="nav-btn" style="-fx-padding: 20;"/>
        </VBox>
    </left>

    <!-- MAIN CONTENT AREA -->
    <center>
        <StackPane fx:id="contentArea">
            <!-- Content will be loaded dynamically here -->
        </StackPane>
    </center>
</BorderPane>
