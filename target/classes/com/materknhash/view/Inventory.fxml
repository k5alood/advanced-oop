<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml" 
      fx:controller="com.materknhash.controller.InventoryController"
      spacing="25" style="-fx-background-color: transparent;"
      stylesheets="@../css/dashboard.css">
    
    <padding>
        <Insets top="30" right="40" bottom="30" left="40"/>
    </padding>
    
    <!-- Header Section -->
    <HBox alignment="CENTER_LEFT">
        <VBox spacing="5">
            <Label text="Inventory Management" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: rgb(15, 23, 42);"/>
            <Label text="Manage your spare parts and stock levels" style="-fx-text-fill: rgb(100, 116, 139);"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <HBox spacing="15" alignment="CENTER">
            <TextField fx:id="searchField" promptText="🔍 Search parts..." prefWidth="300" 
                       style="-fx-background-radius: 20; -fx-padding: 8 15; -fx-background-color: white; -fx-border-color: rgb(226, 232, 240); -fx-border-radius: 20;"/>
            <Button text="+ Add New Part" onAction="#showAddDialog"
                    style="-fx-background-color: rgb(30, 58, 138); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 8 20;"/>
        </HBox>
    </HBox>
    
    <!-- Stats Summary (Mini Cards) -->
    <HBox spacing="20">
        <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 12; -fx-border-color: rgb(226, 232, 240); -fx-border-radius: 12;">
            <Label text="Total Items:" style="-fx-text-fill: rgb(100, 116, 139);"/>
            <Label fx:id="totalItemsLabel" text="0" style="-fx-font-weight: bold; -fx-font-size: 16px;"/>
        </HBox>
        <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-background-color: rgb(254, 242, 242); -fx-padding: 15; -fx-background-radius: 12;">
            <Label text="Low Stock Alerts:" style="-fx-text-fill: rgb(153, 27, 27);"/>
            <Label fx:id="lowStockLabel" text="0" style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: rgb(220, 38, 38);"/>
        </HBox>
    </HBox>

    <!-- Table Section -->
    <VBox VBox.vgrow="ALWAYS" styleClass="activity-card">
        <TableView fx:id="inventoryTable" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="50" />
                <TableColumn fx:id="colCode" text="Part Number" prefWidth="120" />
                <TableColumn fx:id="colName" text="Part Name" prefWidth="200" />
                <TableColumn fx:id="colCategory" text="Category" prefWidth="120" />
                <TableColumn fx:id="colQuantity" text="Stock" prefWidth="80" />
                <TableColumn fx:id="colPrice" text="Price (EGP)" prefWidth="120" />
                <TableColumn fx:id="colSupplier" text="Supplier" prefWidth="150" />
                <TableColumn fx:id="colActions" text="Actions" prefWidth="120" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </VBox>
    
</VBox>
